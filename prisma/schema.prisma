generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Wallet — agregado de saldo con optimistic locking (version)
// ---------------------------------------------------------------------------
model Wallet {
  id             String       @id @default(uuid())
  /// Proyección; fuente de verdad = ledger. CHECK >= 0 en DB (migración).
  currentBalance Decimal      @default(0) @db.Decimal(18, 2)
  currency       String       @default("USD") @db.Char(3)
  kind           WalletKind   @default(USER)
  status         WalletStatus @default(ACTIVE)
  version        Int          @default(1)

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currency])
  @@index([kind])
  @@map("wallets")
}

// ---------------------------------------------------------------------------
// TransactionGroup — una operación lógica (ej. transfer = OUT + IN)
// ---------------------------------------------------------------------------
model TransactionGroup {
  id     String                 @id @default(uuid())
  type   TransactionGroupType
  status TransactionGroupStatus @default(PENDING)

  description       String?
  businessReference String?
  correlationId     String?
  initiatedBy       String?
  metadata          Json?

  ledgerEntries  LedgerEntry[]
  idempotencyKey IdempotencyKey?

  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([correlationId])
  @@index([businessReference])
  @@index([initiatedBy])
  @@index([createdAt])
  @@map("transaction_groups")
}

// ---------------------------------------------------------------------------
// IdempotencyKey — retries seguros (header Idempotency-Key)
// ---------------------------------------------------------------------------
model IdempotencyKey {
  id String @id @default(uuid())

  key   String
  scope String @default("default")

  status IdempotencyStatus @default(PROCESSING)

  requestMethod String?
  requestPath   String?
  requestHash   String?

  responseStatus Int?
  responseBody   Json?

  /// Auditoría cuando requestHash no coincide (TX independiente).
  mismatchAudit Json? @map("mismatch_audit")

  transactionGroupId String?           @unique
  transactionGroup TransactionGroup? @relation(fields: [transactionGroupId], references: [id])

  expiresAt DateTime?
  failureReason String?
  failedAt      DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([scope, key])
  @@index([status])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// LedgerEntry — fuente de verdad del ledger (append-only, auditable)
// amount SIEMPRE positivo; el signo lo define operationType
// ---------------------------------------------------------------------------
model LedgerEntry {
  id String @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  operationType OperationType
  currency      String        @db.Char(3)

  /// Siempre > 0. DEBIT/CREDIT semántico vía operationType, nunca signo en amount.
  amount        Decimal @db.Decimal(18, 2)
  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)

  transactionGroupId String?
  transactionGroup   TransactionGroup? @relation(fields: [transactionGroupId], references: [id])

  referenceId   String?
  correlationId String?

  createdAt DateTime @default(now())

  @@id([id, createdAt])
  @@index([walletId])
  @@index([transactionGroupId])
  @@index([operationType])
  @@index([currency])
  @@index([referenceId])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([operationType, createdAt])
  @@map("ledger_entries")
}

model LedgerPartitionRegistry {
  partitionName String   @id @map("partition_name")
  rangeStart    DateTime @map("range_start")
  rangeEnd      DateTime @map("range_end")
  createdAt     DateTime @default(now()) @map("createdAt")

  @@map("ledger_partition_registry")
}

model FinancialEventOutbox {
  id                   String             @id @default(uuid())
  type                 FinancialEventType
  walletId             String?
  counterpartyWalletId String?
  transactionGroupId   String?
  amount               Decimal?           @db.Decimal(18, 2)
  currency             String?            @db.Char(3)
  metadata             Json?
  status               OutboxStatus       @default(PENDING)
  attempts             Int                @default(0)
  maxAttempts          Int                @default(5) @map("maxAttempts")
  nextRetryAt          DateTime           @default(now()) @map("nextRetryAt")
  lastError            String?            @map("lastError")
  correlationId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, nextRetryAt])
  @@index([transactionGroupId])
  @@map("financial_event_outbox")
}

model FinancialEventDlq {
  id        String   @id @default(uuid())
  outboxId  String   @unique @map("outboxId")
  type      FinancialEventType
  payload   Json
  lastError String   @map("lastError")
  attempts  Int
  failedAt  DateTime @default(now()) @map("failedAt")

  @@map("financial_event_dlq")
}

model WalletCircuitBreaker {
  scope         String
  targetId      String       @map("targetId")
  state         CircuitState @default(CLOSED)
  failureCount  Int          @default(0) @map("failureCount")
  successCount  Int          @default(0) @map("successCount")
  openedAt      DateTime?    @map("openedAt")
  lastFailureAt DateTime?    @map("lastFailureAt")
  nextAttemptAt DateTime?    @map("nextAttemptAt")
  updatedAt     DateTime     @updatedAt

  @@id([scope, targetId])
  @@map("wallet_circuit_breakers")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String   @map("entityType")
  entityId      String?  @map("entityId")
  actor         String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("audit_log")
}

model MvRefreshWatermark {
  viewKey            String    @map("viewKey")
  bucketDate         DateTime  @db.Date @map("bucketDate")
  lastEntryCreatedAt DateTime? @map("lastEntryCreatedAt")
  lastEntryId        String?   @map("lastEntryId")
  refreshedAt        DateTime  @default(now()) @map("refreshedAt")

  @@id([viewKey, bucketDate])
  @@map("mv_refresh_watermarks")
}

// ---------------------------------------------------------------------------
// FinancialSnapshot — cierre diario inmutable (capa analítica, read-only)
// ---------------------------------------------------------------------------
model FinancialSnapshot {
  id                 String   @id @default(uuid())
  snapshotDate       DateTime @db.Date @map("snapshot_date")
  /// Cierre contable [periodStart, periodEnd) UTC — congelado al persistir.
  periodStart        DateTime @map("period_start")
  periodEnd          DateTime @map("period_end")
  currency           String   @default("USD") @db.Char(3)
  totalSystemBalance Decimal  @db.Decimal(18, 2)
  totalFeeRevenue    Decimal  @db.Decimal(18, 2)
  totalVolume        Decimal  @db.Decimal(18, 2)
  createdAt          DateTime @default(now())

  @@unique([snapshotDate, currency])
  @@index([snapshotDate])
  @@map("financial_snapshots")
}

// ---------------------------------------------------------------------------
// FinancialEvent — lightweight event stream (3.0 intelligence path)
// ---------------------------------------------------------------------------
model FinancialEvent {
  id                 String             @id @default(uuid())
  type               FinancialEventType
  walletId           String?
  counterpartyWalletId String?
  transactionGroupId String?
  amount             Decimal?           @db.Decimal(18, 2)
  currency           String?            @db.Char(3)
  metadata           Json?
  createdAt          DateTime           @default(now())

  @@index([type, createdAt])
  @@index([walletId, createdAt])
  @@index([transactionGroupId])
  @@map("financial_events")
}

// ---------------------------------------------------------------------------
// Materialized views — incremental refresh (reporting acceleration)
// ---------------------------------------------------------------------------
model DailyWalletBalance {
  bucketDate     DateTime @db.Date @map("bucket_date")
  walletId       String
  currency       String   @db.Char(3)
  ledgerBalance  Decimal  @db.Decimal(18, 2)
  entryCount     Int      @default(0)
  refreshedAt    DateTime @default(now()) @map("refreshed_at")

  @@id([bucketDate, walletId])
  @@index([walletId])
  @@map("mv_daily_wallet_balance")
}

model DailyFeeRevenue {
  bucketDate  DateTime @db.Date @map("bucket_date")
  currency    String   @db.Char(3)
  totalFees   Decimal  @db.Decimal(18, 2)
  entryCount  Int      @default(0)
  refreshedAt DateTime @default(now()) @map("refreshed_at")

  @@id([bucketDate, currency])
  @@map("mv_daily_fee_revenue")
}

model DailySystemVolume {
  bucketDate   DateTime @db.Date @map("bucket_date")
  currency     String   @db.Char(3)
  totalVolume  Decimal  @db.Decimal(18, 2)
  refreshedAt  DateTime @default(now()) @map("refreshed_at")

  @@id([bucketDate, currency])
  @@map("mv_daily_system_volume")
}

enum FinancialEventType {
  DEPOSIT_COMPLETED
  TRANSFER_COMPLETED
  WITHDRAW_COMPLETED
  FEE_APPLIED
  WALLET_CREATED
}

enum WalletKind {
  USER
  SYSTEM_FEE
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum OperationType {
  DEPOSIT
  WITHDRAW
  TRANSFER_IN
  TRANSFER_OUT
  FEE_IN
  FEE_OUT
}

enum TransactionGroupType {
  DEPOSIT
  WITHDRAW
  TRANSFER
  ADJUSTMENT
}

enum TransactionGroupStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  DLQ
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}
