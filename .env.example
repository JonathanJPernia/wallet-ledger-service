# PASO 9 — variables base (copiar a .env)
# Nota: docker-compose de este repo expone Postgres en el host en 5433 (5433:5432).
# Si usas Postgres nativo en 5432, cambia el puerto en DATABASE_URL.

DATABASE_URL=postgresql://wallet_user:wallet_password@localhost:5433/wallet_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

# Railway sets PORT automatically; bind uses 0.0.0.0 in main.ts
PORT=3000
NODE_ENV=development

# Production (Railway auto-injects RAILWAY_GIT_COMMIT_SHA for /api/health)
# APP_VERSION=0.0.1
# BUILD_SHA=

# CORS — comma-separated origins (production). Empty = no CORS in production.
# CORS_ORIGINS=https://tu-frontend.com,https://www.tu-frontend.com

# Prisma logs: start verbose, then remove query (use warn,error only)
# PRISMA_LOG=query,info,warn,error
# PRISMA_LOG_QUERY=true
# PRISMA_LOG_INFO=true

# Opcionales (ConfigModule / logging)
# APP_NAME=wallet-ledger-service
# LOG_LEVEL=info

# DB migrations in deploy: npm run deploy:migrate (prisma migrate deploy)
# Never use prisma db push in production.

# Reconciliation v2: auto-repair solo drifts LOW (|diff| < 1.00)
# RECONCILIATION_AUTO_REPAIR=false

# Load tests (requieren API + DB): RUN_LOAD_TESTS=true npm run test:load
