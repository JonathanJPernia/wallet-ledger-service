# PASO 9 — variables base (copiar a .env)
# Nota: docker-compose de este repo expone Postgres en el host en 5433 (5433:5432).
# Si usas Postgres nativo en 5432, cambia el puerto en DATABASE_URL.

DATABASE_URL=postgresql://wallet_user:wallet_password@localhost:5433/wallet_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000
NODE_ENV=development

# Opcionales (ConfigModule / logging)
# APP_NAME=wallet-ledger-service
# LOG_LEVEL=info
